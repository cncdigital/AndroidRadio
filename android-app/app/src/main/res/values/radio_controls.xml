<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RadioWindowButton">
        <item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item>
        <item name="android:padding">13dp</item><item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/radio_control_surface</item>
        <item name="android:tint">@color/radio_control_icon</item>
        <item name="android:focusable">true</item><item name="android:clickable">true</item>
    </style>
    <style name="RadioTransportButton" parent="RadioWindowButton">
        <item name="android:layout_width">56dp</item><item name="android:layout_height">56dp</item>
        <item name="android:padding">15dp</item>
        <item name="android:background">@drawable/radio_transport_surface</item>
    </style>
    <style name="RadioPlayButton" parent="RadioTransportButton">
        <item name="android:layout_width">76dp</item><item name="android:layout_height">76dp</item>
        <item name="android:layout_marginHorizontal">22dp</item><item name="android:padding">22dp</item>
        <item name="android:background">@drawable/radio_play_surface</item>
        <item name="android:tint">@color/radio_play_icon</item>
        <item name="android:elevation">6dp</item>
    </style>
    <style name="RadioActionButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item><item name="android:layout_marginTop">10dp</item>
        <item name="android:paddingHorizontal">18dp</item><item name="android:paddingVertical">14dp</item>
        <item name="android:background">@drawable/radio_action_surface</item><item name="android:backgroundTint">@null</item>
        <item name="android:drawablePadding">16dp</item><item name="android:drawableTint">@color/radio_action_ink</item>
        <item name="android:textColor">@color/radio_action_ink</item><item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item><item name="android:gravity">start|center_vertical</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
