<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio_screen" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/sntss_blue">
    <LinearLayout android:id="@+id/radio_window_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical|end"
        android:paddingHorizontal="12dp" android:paddingVertical="8dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="SNTSS · SECCIÓN I PUEBLA" android:textColor="@color/sntss_gold"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="2" android:paddingEnd="8dp" />
        <ImageButton android:id="@+id/close_radio" style="@style/RadioWindowButton"
            android:src="@drawable/ic_control_close" android:contentDescription="@string/radio_close_app" android:tooltipText="@string/radio_close_app" />
        <ImageButton android:id="@+id/minimize_radio" style="@style/RadioWindowButton"
            android:src="@drawable/ic_control_minimize" android:contentDescription="@string/radio_minimize" android:tooltipText="@string/radio_minimize" />
        <ImageButton android:id="@+id/maximize_radio" style="@style/RadioWindowButton"
            android:src="@drawable/ic_control_maximize" android:contentDescription="@string/radio_maximize" android:tooltipText="@string/radio_maximize" />
    </LinearLayout>
<ScrollView
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:fillViewport="true" android:background="@color/sntss_blue">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="24dp">
        <mx.sntss1puebla.credenciales.RadioArtworkFrame android:id="@+id/radio_artwork" android:layout_width="280dp" android:layout_height="280dp"
            android:layout_marginTop="18dp" android:accessibilityLiveRegion="polite">
            <ImageView android:id="@+id/song_cover" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:src="@drawable/ic_radio" android:importantForAccessibility="no" />
            <mx.sntss1puebla.credenciales.RadioVisualizerView android:id="@+id/radio_visualizer"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:importantForAccessibility="no" android:visibility="gone" />
            <TextView android:id="@+id/ghost_lyric" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_gravity="bottom"
                android:padding="16dp" android:gravity="center" android:maxLines="3"
                android:background="#B3071D36" android:textColor="#FFDA79"
                android:shadowColor="#000000" android:shadowRadius="8" android:shadowDx="1" android:shadowDy="2"
                android:textSize="25sp" android:textStyle="bold" android:visibility="gone" />
        </mx.sntss1puebla.credenciales.RadioArtworkFrame>
        <Button android:id="@+id/radio_youtube" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginVertical="4dp" android:textAllCaps="false"
            android:text="@string/radio_youtube_open" android:visibility="gone" />
        <TextView android:id="@+id/song_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:gravity="center" android:text="@string/radio_title" android:textColor="@android:color/white"
            android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/song_artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:gravity="center" android:text="@string/radio_subtitle"
            android:textColor="#CADCE9" android:textSize="16sp" />
        <TextView android:id="@+id/radio_cache_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:gravity="center" android:textColor="#CADCE9" android:textSize="13sp"
            android:text="Caché musical · 10 GiB · precarga automática con Wi-Fi" />
        <SeekBar android:id="@+id/song_seek" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="30dp"
            android:progressTint="@color/sntss_gold" android:thumbTint="@color/sntss_gold" />
        <TextView android:id="@+id/song_progress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:text="0:00 / 0:00"
            android:textColor="#CADCE9" android:textSize="14sp" />
        <TextView android:id="@+id/song_bitrate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:gravity="center" android:text="Bitrate: automática"
            android:textColor="@color/sntss_gold" android:textSize="13sp" android:textStyle="bold" />
        <Spinner android:id="@+id/quality_spinner" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:contentDescription="@string/radio_quality_label" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/previous_song" style="@style/RadioTransportButton"
                android:src="@drawable/ic_control_previous" android:contentDescription="@string/radio_previous" android:tooltipText="@string/radio_previous" />
            <ImageButton android:id="@+id/play_native_radio" style="@style/RadioPlayButton"
                android:src="@drawable/ic_control_play" android:contentDescription="@string/play_radio_car" android:tooltipText="@string/play_radio_car" />
            <ImageButton android:id="@+id/next_song" style="@style/RadioTransportButton"
                android:src="@drawable/ic_control_next" android:contentDescription="@string/radio_next" android:tooltipText="@string/radio_next" />
        </LinearLayout>
        <LinearLayout android:id="@+id/radio_secondary_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/radio_shuffle" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_shuffle" android:contentDescription="Otra canción aleatoria" android:tooltipText="Otra canción aleatoria" />
            <ImageButton android:id="@+id/radio_favorite" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_favorite" android:contentDescription="Guardar canción favorita" android:tooltipText="Guardar canción favorita" />
            <ImageButton android:id="@+id/radio_audio" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_audio" android:contentDescription="Mejoras de audio" android:tooltipText="Mejoras de audio" />
            <ImageButton android:id="@+id/radio_tastes" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_tastes" android:contentDescription="Mis gustos musicales" android:tooltipText="Mis gustos musicales" />
            <ImageButton android:id="@+id/radio_capsules" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_capsules_low" android:contentDescription="Cápsulas frecuentes" android:tooltipText="Cápsulas frecuentes" />
        </LinearLayout>
        <TextView android:id="@+id/radio_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:gravity="center" android:text="@string/radio_ready"
            android:textColor="#CADCE9" android:textSize="15sp" />
        <TextView android:id="@+id/network_warning" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:gravity="center" android:textColor="#AFC4D2" android:textSize="10sp"
            android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/song_lyrics_title"
            android:textColor="@color/sntss_gold" android:textSize="18sp" android:textStyle="bold" />
        <ScrollView android:id="@+id/lyrics_scroll" android:layout_width="match_parent"
            android:layout_height="240dp" android:layout_marginTop="8dp"
            android:background="#123751" android:fillViewport="true" android:nestedScrollingEnabled="true">
            <TextView android:id="@+id/song_lyrics" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="16dp"
                android:text="@string/song_lyrics_empty" android:textColor="@android:color/white"
                android:textSize="20sp" android:lineSpacingExtra="12dp" android:gravity="center" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
</LinearLayout>
