<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/full_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/sntss_blue">
    <ImageView android:id="@+id/full_cover" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitCenter"
        android:src="@drawable/ic_radio" android:contentDescription="@string/radio_title" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:padding="20dp" android:background="#D9071D36">
        <ProgressBar android:id="@+id/full_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="10dp"
            android:max="1000" android:progressTint="#FFB323" android:progressBackgroundTint="#FFFFFF"
            android:contentDescription="Progreso de la canción" />
        <TextView android:id="@+id/full_time" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:paddingVertical="4dp"
            android:textColor="#FFFFFF" android:textSize="14sp" />
        <Button android:id="@+id/full_favorite" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="♡ Favorito" android:contentDescription="Guardar canción favorita" />
        <Button android:id="@+id/full_shuffle" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="6dp"
            android:backgroundTint="@color/sntss_gold" android:text="@string/radio_shuffle"
            android:contentDescription="@string/radio_shuffle_desc" />
        <Button android:id="@+id/full_karaoke" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Karaoke · reducir voz"
            android:contentDescription="Activar karaoke con reducción de voz central; depende de la mezcla original" />
        <TextView android:id="@+id/full_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:textColor="@android:color/white" android:textSize="20sp"
            android:textStyle="bold" android:maxLines="2" />
        <TextView android:id="@+id/full_artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:textColor="#CADCE9" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
            <Button android:id="@+id/full_previous" android:layout_width="wrap_content"
                android:layout_height="52dp" android:text="@string/radio_previous" />
            <Button android:id="@+id/full_play" android:layout_width="wrap_content"
                android:layout_height="52dp" android:layout_marginHorizontal="8dp"
                android:backgroundTint="@color/sntss_gold" android:text="@string/play_radio_car" />
            <Button android:id="@+id/full_next" android:layout_width="wrap_content"
                android:layout_height="52dp" android:text="@string/radio_next" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/full_lyric" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:maxWidth="360dp" android:minHeight="90dp" android:padding="18dp"
        android:gravity="center" android:background="#CC071D36" android:elevation="12dp"
        android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"
        android:maxLines="4" android:shadowColor="#000000" android:shadowRadius="8"
        android:shadowDx="1" android:shadowDy="2" android:clickable="true" />
    <Button android:id="@+id/full_close" android:layout_width="wrap_content"
        android:layout_height="48dp" android:layout_gravity="top|end"
        android:layout_margin="16dp" android:text="@string/radio_close_fullscreen" />
    <Button android:id="@+id/full_lyric_move" android:layout_width="wrap_content"
        android:layout_height="42dp" android:layout_gravity="top|start"
        android:layout_margin="16dp" android:text="@string/radio_move_lyrics"
        android:contentDescription="@string/radio_move_lyrics" />
</FrameLayout>
