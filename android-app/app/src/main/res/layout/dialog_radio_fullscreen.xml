<?xml version="1.0" encoding="utf-8"?>
<mx.sntss1puebla.credenciales.RadioFullscreenFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/full_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/sntss_blue">
    <mx.sntss1puebla.credenciales.RadioArtworkFrame android:id="@+id/full_artwork"
        android:layout_width="match_parent" android:layout_height="match_parent" android:accessibilityLiveRegion="polite">
    <ImageView android:id="@+id/full_cover" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitCenter"
        android:src="@drawable/ic_radio" android:importantForAccessibility="no" />
    <mx.sntss1puebla.credenciales.RadioVisualizerView android:id="@+id/full_visualizer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" android:visibility="gone" />
    </mx.sntss1puebla.credenciales.RadioArtworkFrame>
    <LinearLayout android:id="@+id/full_controls" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:padding="20dp" android:background="#D9071D36">
        <ProgressBar android:id="@+id/full_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="10dp"
            android:max="1000" android:progressTint="#FFB323" android:progressBackgroundTint="#FFFFFF"
            android:contentDescription="Progreso de la canción" />
        <TextView android:id="@+id/full_time" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:paddingVertical="4dp"
            android:textColor="#FFFFFF" android:textSize="14sp" />
        <LinearLayout android:id="@+id/full_secondary_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/full_favorite" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_favorite" android:contentDescription="Guardar canción favorita" android:tooltipText="Guardar canción favorita" />
            <ImageButton android:id="@+id/full_shuffle" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_shuffle" android:contentDescription="Otra canción aleatoria" android:tooltipText="Otra canción aleatoria" />
            <ImageButton android:id="@+id/full_karaoke" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_karaoke" android:contentDescription="Activar karaoke" android:tooltipText="Activar karaoke" />
            <ImageButton android:id="@+id/full_capsules" style="@style/RadioActionIconButton" android:src="@drawable/ic_action_capsules_low" android:contentDescription="Cápsulas frecuentes" android:tooltipText="Cápsulas frecuentes" />
        </LinearLayout>
        <TextView android:id="@+id/full_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:textColor="@android:color/white" android:textSize="20sp"
            android:textStyle="bold" android:maxLines="2" />
        <TextView android:id="@+id/full_artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:textColor="#CADCE9" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/full_previous" style="@style/RadioTransportButton"
                android:src="@drawable/ic_control_previous" android:contentDescription="@string/radio_previous" android:tooltipText="@string/radio_previous" />
            <ImageButton android:id="@+id/full_play" style="@style/RadioPlayButton"
                android:src="@drawable/ic_control_play" android:contentDescription="@string/play_radio_car" android:tooltipText="@string/play_radio_car" />
            <ImageButton android:id="@+id/full_next" style="@style/RadioTransportButton"
                android:src="@drawable/ic_control_next" android:contentDescription="@string/radio_next" android:tooltipText="@string/radio_next" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/full_lyric" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:maxWidth="360dp" android:minHeight="90dp" android:padding="18dp"
        android:gravity="center" android:background="#CC071D36" android:elevation="12dp"
        android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"
        android:maxLines="4" android:shadowColor="#000000" android:shadowRadius="8"
        android:shadowDx="1" android:shadowDy="2" android:clickable="true" />
    <ImageButton android:id="@+id/full_close" style="@style/RadioWindowButton"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:src="@drawable/ic_control_restore" android:contentDescription="@string/radio_close_fullscreen"
        android:tooltipText="@string/radio_close_fullscreen" />
    <Button android:id="@+id/full_lyric_move" android:layout_width="wrap_content"
        android:layout_height="42dp" android:layout_gravity="top|start"
        android:layout_margin="16dp" android:text="@string/radio_move_lyrics"
        android:contentDescription="@string/radio_move_lyrics" />
</mx.sntss1puebla.credenciales.RadioFullscreenFrame>
